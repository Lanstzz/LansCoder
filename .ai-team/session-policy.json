{
  "schemaVersion": 1,
  "enabled": true,
  "repositoryVisibility": "private",
  "readPriority": "low",
  "capture": {
    "userMessages": "verbatim",
    "assistantMessages": "final-response",
    "systemPrompts": "exclude",
    "chainOfThought": "exclude",
    "rawToolOutput": "exclude",
    "gitMetrics": true,
    "wallTime": true,
    "tokenUsage": "when-available"
  }
}
