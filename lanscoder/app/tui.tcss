Screen {
    layout: vertical;
    background: #0f1014;
    color: #cfd1d6;
    overflow: hidden;
}

* {
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-color: transparent;
    scrollbar-background: transparent;
    scrollbar-color-hover: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-color-active: transparent;
    scrollbar-background-active: transparent;
    scrollbar-corner-color: transparent;
}

ScrollBar,
ScrollBarCorner {
    display: none;
}

#main {
    height: 1fr;
    background: #0f1014;
    overflow: hidden;
}

.topbar {
    height: auto;
    min-height: 2;
    padding: 0 2;
    background: #0f1014;
    color: #6e6d72;
    border-bottom: solid #303238;
    text-style: none;
}

#output {
    height: 1fr;
    padding: 1 3;
    background: #0f1014;
}

#output.welcome-active {
    align: center middle;
}

.welcome {
    width: 100%;
    margin: 0;
    padding: 0;
    background: #0f1014;
    color: #cfd1d6;
}

.composer {
    height: auto;
    max-height: 9;
    margin: 0 2 0 2;
    background: #0f1014;
    border-top: solid #626263;
}

/* 联想栏是 composer 上方的兄弟节点:左右对齐输入框,弹出时不推挤输入框。 */
#main SlashSuggest {
    margin: 0 2 1 2;
}

#input {
    height: 3;
    margin: 0;
    padding: 0 1;
    background: #0f1014;
    background-tint: transparent;
    color: #808185;
    border: none;
}

#input:focus {
    background: #0f1014;
    background-tint: transparent;
    color: #cfd1d6;
    border: none;
}

#input > .input--cursor {
    background: #cfd1d6;
    color: #0f1014;
    text-style: none;
}

#input > .input--selection {
    background: #0f1014;
    color: #cfd1d6;
}

#input > .text-area--placeholder {
    color: #808185;
}

.activity-line {
    height: 1;
    margin: 0 3;
    color: #2b5fd9;
}

.task-plan-panel {
    height: auto;
    max-height: 8;
    margin: 0 3 1 3;
    padding: 0 1;
    color: #cfd1d6;
    background: #0f1014;
    border-left: solid #4f8cff;
}

.task-plan-panel.hidden {
    display: none;
}

.message {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1 0 1;
    background: #0f1014;
}

.system-message,
.command-message,
.reasoning-message,
.tool-message {
    color: #808185;
    background: #0f1014;
    border-left: solid #666769;
}

.tool-running,
.tool-done,
.tool-failed,
.tool-denied {
    color: #808185;
    background: #0f1014;
    border-left: solid #666769;
}

.user-message {
    color: #cfd1d6;
    background: #0f1014;
    border-left: solid #ffffff;
}

.assistant-message {
    color: #cfd1d6;
    background: #0f1014;
    border-left: solid #4f8cff;
}

.assistant-message MarkdownBlock {
    margin: 0;
}

/* 助手消息第一段是标签行（LansCoder），染成品牌蓝，正文段落保持默认色。 */
.assistant-message MarkdownParagraph:first-of-type {
    color: #4f8cff;
}

.reasoning-message {
    color: #2b5fd9;
    border-left: solid #4f8cff;
}

.permission-message,
.permission-requested {
    color: #b28443;
    background: #0f1014;
    border-left: solid #b28443;
}

.error-message {
    color: #c85f5f;
    background: #0f1014;
    border-left: solid #c85f5f;
}

.streaming {
    border-left: solid #4f8cff;
}

#subagent-panel {
    height: auto;
    min-height: 0;
    margin: 0 3 0 3;
    padding: 0 1;
    background: #0f1014;
    color: #808185;
    border-top: solid #303238;
}
#subagent-panel.hidden {
    display: none;
}
#subagent-panel Static {
    width: 100%;
    height: 1;
    color: #808185;
}
#subagent-panel Static.selected {
    background: #2b5fd9;
    color: #ffffff;
    text-style: bold;
}
#subagent-panel .subagent-hint {
    color: #5a5c64;
    text-style: dim;
}
