Screen {
    layout: vertical;
    background: #0f1014;
    color: #d1d5db;
    link-color: #4f8cff;
    link-color-hover: #7db6ff;
    overflow: hidden;
}

* {
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-color: transparent;
    scrollbar-background: transparent;
    scrollbar-color-hover: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-color-active: transparent;
    scrollbar-background-active: transparent;
    scrollbar-corner-color: transparent;
}

ScrollBar,
ScrollBarCorner {
    display: none;
}

#main {
    height: 1fr;
    background: #0f1014;
    overflow: hidden;
}

.topbar {
    height: auto;
    min-height: 2;
    padding: 0 2;
    background: #0f1014;
    color: #6e6d72;
    border-bottom: solid #232830;
    text-style: none;
}

#output {
    height: 1fr;
    padding: 1 3;
    background: #0f1014;
}

#output.welcome-active {
    align: center middle;
}

.welcome {
    width: 100%;
    margin: 0;
    padding: 0;
    background: #0f1014;
    color: #d1d5db;
}

.composer {
    height: auto;
    max-height: 9;
    margin: 0 2 0 2;
    background: #0f1014;
    border-top: solid #626263;
}

/* 联想栏是 composer 上方的兄弟节点:左右对齐输入框,弹出时不推挤输入框。 */
#main SlashSuggest {
    margin: 0 2 1 2;
    background: #0f1014;
    border: solid #4f8cff;
}

#input {
    height: 3;
    margin: 0;
    padding: 0 1;
    background: #0f1014;
    background-tint: transparent;
    color: #8a93a6;
    border: none;
}

#input:focus {
    background: #0f1014;
    background-tint: transparent;
    color: #d1d5db;
    border: none;
}

#input > .input--cursor {
    background: #d1d5db;
    color: #0f1014;
    text-style: none;
}

#input > .input--selection {
    background: #0f1014;
    color: #d1d5db;
}

#input > .text-area--placeholder {
    color: #8a93a6;
}

.activity-line {
    height: 1;
    margin: 0 3;
    color: #4f8cff;
}

.task-plan-panel {
    height: auto;
    max-height: 8;
    margin: 0 3 1 3;
    padding: 0 1;
    color: #d1d5db;
    background: #0f1014;
    border-left: solid #4f8cff;
}

.task-plan-panel.hidden {
    display: none;
}

.message {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1 0 1;
    background: #0f1014;
}

.system-message,
.command-message,
.reasoning-message,
.tool-message {
    color: #8a93a6;
    background: #0f1014;
    border-left: solid #4a5365;
}

.tool-running,
.tool-done,
.tool-failed,
.tool-denied {
    color: #8a93a6;
    background: #0f1014;
    border-left: solid #4a5365;
}

.user-message {
    color: #f8f8f8;
    background: #373737;
    border-left: solid #ffffff;
}

.assistant-message {
    color: #d1d5db;
    background: #0f1014;
    border-left: solid #4f8cff;
}

.assistant-message MarkdownBlock {
    margin: 0;
}

/* 助手消息第一段是标签行（LansCoder），染成品牌蓝，正文段落保持默认色。
   必须用直系子选择器：`:first-of-type` 会误中每个列表项自己的首个段落。 */
.assistant-message > MarkdownParagraph:first-of-type {
    color: #4f8cff;
}

/* markdown 内建色覆盖：标题/行内代码/代码块/引用/圆点/表格统一进品牌蓝-青灰系 */
.assistant-message MarkdownH1 { color: #6198ff; content-align: left top; }
.assistant-message MarkdownH2 { color: #72a3ff; }
.assistant-message MarkdownH3 { color: #84afff; }
.assistant-message MarkdownH4,
.assistant-message MarkdownH5,
.assistant-message MarkdownH6 { color: #95baff; }
.assistant-message .code_inline {
    color: #e2e8f0;
    background: #4f8cff 15%;
}
.assistant-message MarkdownFence {
    color: #cbd5e1;
    background: #151820;
}
.assistant-message MarkdownBlockQuote {
    color: #94a3b8;
    border-left: outer #4f8cff 40%;
}
.assistant-message MarkdownBullet { color: #4f8cff 60%; }
.assistant-message MarkdownBulletList Vertical,
.assistant-message MarkdownOrderedList Vertical { color: #d1d5db; }
.assistant-message MarkdownHorizontalRule { border-bottom: solid #4f8cff 60%; }
.assistant-message MarkdownTableContent { keyline: thin #2a3340; }
.assistant-message MarkdownTableContent .cell { color: #cbd5e1; }
.assistant-message MarkdownTableContent .header { color: #e2e8f0; }

.reasoning-message {
    color: #66c4d8;
    border-left: solid #4f8cff;
}

.permission-message,
.permission-requested {
    color: #FF4444;
    background: #0f1014;
    border-left: solid #FF4444;
}

.error-message {
    color: #e57378;
    background: #0f1014;
    border-left: solid #e57378;
}

.streaming {
    border-left: solid #4f8cff;
}

.child-row {
    width: 100%;
    height: 1;
    margin: 0 0 1 3;
    color: #8a93a6;
}

.child-row.expanded {
    height: auto;
    max-height: 40;
}

.child-row:hover {
    color: #ffffff;
}

/* thinking 与 tool 默认同为深灰(.child-row),hover 亮白;tool 保留左侧主题框 */
.child-tool {
    border-left: solid #4f8cff;
}

#subagent-panel {
    height: auto;
    min-height: 0;
    margin: 0 3 0 3;
    padding: 0 1;
    background: #0f1014;
    color: #8a93a6;
    border-top: solid #232830;
}
#subagent-panel.hidden {
    display: none;
}
#subagent-panel Static {
    width: 100%;
    height: 1;
    color: #8a93a6;
}
#subagent-panel Static.selected {
    background: #66c4d8;
    color: #ffffff;
    text-style: bold;
}
#subagent-panel .subagent-hint {
    color: #5a5c64;
    text-style: dim;
}
